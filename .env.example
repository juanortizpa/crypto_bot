# ═══════════════════════════════════════════════════════════════
# Binance Testnet API Keys
# ═══════════════════════════════════════════════════════════════
# 1. Ve a https://testnet.binance.vision/
# 2. Inicia sesion con tu cuenta GitHub
# 3. Haz click en "Generate HMAC_SHA256 Key"
# 4. Copia API Key y Secret Key aqui abajo
# 5. Renombra este archivo a .env
# ═══════════════════════════════════════════════════════════════

BINANCE_API_KEY=tu_api_key_aqui
BINANCE_SECRET_KEY=tu_secret_key_aqui

# Modo: testnet (paper trading) o live (dinero real)
# NUNCA cambies a live sin haber validado con testnet primero
BINANCE_MODE=testnet

# Auto-ejecutar ordenes (False = solo predicciones)
AUTO_EXECUTE=False
